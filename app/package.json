{
  "name": "docfactory",
  "version": "0.1.2",
  "description": "DocFactory —— Windows 离线 RAG 文档数据工厂",
  "main": "out/main/index.js",
  "author": "DocFactory Team",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "ui:shot": "electron-vite build && electron tools/ui-shot.mjs",
    "pack:dir": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder --win nsis"
  },
  "dependencies": {
    "electron-log": "^5.4.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "42.7.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
